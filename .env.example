POSTGRES_DB=expense_app
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
HTTP_ADDR=:8080

# Required for server only, random secret of at least 32 bytes
JWT_SECRET=
JWT_ISSUER=expense-app
JWT_AUDIENCE=expense-app-mobile
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=720h

# Optional Cloudflare R2 S3 credentials. Leave all four blank to disable image uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUT_URL_TTL=10m
R2_GET_URL_TTL=15m
